# Port used by the local application/API layer.
PORT=5001

# Your Firebase project id, for example: interview-buddy-12345
FIREBASE_PROJECT_ID=example-project-id

# React development origin.
CLIENT_ORIGIN=http://localhost:3000

# Recommended local authentication method for Firebase Admin:
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to the absolute path of a
# Firebase service-account JSON file. Never commit that JSON file to git.
#
# macOS/Linux example:
# export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/service-account.json"
#
# Windows PowerShell example:
# $env:GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\service-account.json"
#
# Alternative for hosted environments only: store the complete service account
# JSON as one secret environment variable. Do not put it in committed files.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# AI provider selection. The application layer depends on aiService, while
# provider-specific SDK details stay under server/src/services/providers/.
AI_PROVIDER=anthropic

# Required only when AI_PROVIDER=anthropic. Firebase question retrieval and quiz
# checking work without these values.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Daily shared question allowance for standard users.
# Code Style and Theoretical Style both consume this allowance.
# Quiz Style does not.
USER_DAILY_QUESTION_LIMIT=20

# Daily reset boundary.
DAILY_QUESTION_QUOTA_TIME_ZONE=America/Los_Angeles

# SEC-04 independent provider-attempt budget.
# Separate from the daily question retrieval limit.
USER_DAILY_AI_EVALUATION_LIMIT=20

# SEC-04 Part 3
AI_PROVIDER_TIMEOUT_MS=20000
AI_UNDISPATCHED_LEASE_MS=120000
AI_REVIEW_DELAY_MS=300000
# SEC-05 Part 2: authenticated, distributed API rate limits (per minute).
# Applied after Firebase token verification, before profile database reads.
API_RATE_LIMIT_GLOBAL_PER_MINUTE=120
API_RATE_LIMIT_QUESTIONS_PER_MINUTE=40
API_RATE_LIMIT_EVALUATIONS_PER_MINUTE=12
API_RATE_LIMIT_SESSION_WRITES_PER_MINUTE=40
API_RATE_LIMIT_USERS_PER_MINUTE=30
# REQUIRED: configure Firestore TTL for collection group apiRateLimits,
# timestamp field expiresAt; old counters otherwise accumulate indefinitely.
# Also configure an edge IP/WAF limiter to protect unauthenticated traffic.

# SEC-05 Part 3: maximum new interview sessions created per user per LA day.
# This is separate from the SEC-05 Part 2 per-minute request limits.
SESSION_DAILY_CREATE_LIMIT=30
# Session list page cap is 50 (server-defined), client defaults to 25.
# Configure Firestore TTL on collection group sessionCreationUsage, field
# expiresAt, to clean up old per-day counter documents automatically.

# SEC-05 Part 3B: active session capacity (1-10) and hard lifetime (1-720 hours)
SESSION_ACTIVE_LIMIT=5
SESSION_ACTIVE_LIFETIME_HOURS=168

# SEC-05 Part 4: hard bound for a single mode-wide Firestore question scan.
# Default 5000, configured range 100-100000. Query reads limit+1 to detect
# overflow; excess questions fail closed rather than silently truncating.
QUESTION_MODE_SCAN_LIMIT=5000