
{
  "name": "interview-buddy-server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node scripts/seedQuestions.js",
    "apply-code-style-rubric": "node scripts/applyCodeStyleRubric.js",
    "set-role": "node scripts/setUserRole.js",
    "backfill-user-roles": "node scripts/backfillUserRoles.js",
    "cleanup-orphaned-users": "node scripts/cleanupOrphanedUsers.js",
    "sync-auth-users": "node scripts/syncAuthUsersToFirestore.js",
    "audit-user-fields": "node scripts/auditUserFields.js",
    "reset-google-test-accounts": "node scripts/resetGoogleTestAccounts.js",
    "test": "jest",
    "lint": "eslint src",
    "test:emulator": "node --test --test-concurrency=1 test/firestore.emulator.test.cjs",
    "test:session:emulator": "node --test --test-concurrency=1 test/session.integration.emulator.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "body-parser": "1.20.9"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/test/firestore\\.emulator\\.test\\.cjs$"
    ]
  }
}
